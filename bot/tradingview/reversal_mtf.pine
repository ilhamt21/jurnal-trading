//@version=5
// Indikasi reversal multi-timeframe (jurnal-trading)
// Rantai (1 HTF = 4 MTF, 1 MTF = 4 LTF): Daily -> H6 -> M90  atau  H4 -> H1 -> M15
// Pasang di chart timeframe kecil (M90 atau M15), atau lebih kecil lagi.
//
// Reversal BULLISH (C1 = candle HTF sebelumnya bearish, C2 = candle HTF sekarang):
//   Sinyal = candle MTF close kembali DI ATAS low C1 (PDL) DAN di atas open C2,
//            setelah C2 menyapu low C1.
// Reversal BEARISH kebalikannya.
//
// Skor 0-10 (ciri reversal):
//   1  C1 berlawanan arah (bearish untuk reversal bullish)
//   2  C1 close dekat ekstrem (<= 20% dari low)          -> likuiditas fresh
//   3  C1 berakhir lemah (MTF terakhir C1: ekstrem baru, body kecil / wick)
//   4  C1 klimaks (range >= X kali rata-rata range HTF)
//   5  Low C1 = low terendah 5 candle HTF (menyapu low beberapa candle)
//   6  C2 menyapu low C1
//   7  Sweep terjadi di MTF ke-1 atau ke-2 (awal candle)
//   8  MTF close kembali di atas low C1 dan di atas open C2   (pemicu)
//   9  Ada FVG bullish di TF kecil setelah sweep (displacement)
//   10 TF kecil close di atas high candle yang membuat low sweep (struktur berubah)
indicator("Indikasi Reversal MTF (jurnal-trading)", shorttitle="Reversal MTF", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500)

// ---------- Pengaturan ----------
mode      = input.string("Daily - H6 - M90", "Rantai timeframe", options=["Daily - H6 - M90", "H4 - H1 - M15"])
showBull  = input.bool(true, "Reversal BULLISH")
showBear  = input.bool(true, "Reversal BEARISH")
minScore  = input.int(5, "Skor minimal untuk sinyal", minval=3, maxval=10)
closeZone = input.float(20, "Ciri 2: C1 close dekat ekstrem (%)", minval=1, maxval=50)
climaxK   = input.float(1.5, "Ciri 4: klimaks = range C1 >= X kali rata-rata", minval=1, step=0.1)
showLvl   = input.bool(false, "Gambar high/low C1 dan open C2")
showMtf   = input.bool(true, "Candle bayangan MTF (H6 untuk Daily / H1 untuk H4)")
showHtf   = input.bool(false, "Candle bayangan HTF (Daily / H4)")
sweepAlrt = input.bool(false, "Alert juga saat sweep terjadi (sebelum pemicu)")

grpE      = "ENTRY: bias MTF lalu sweep candle kecil"
useEntry  = input.bool(true, "Tampilkan sinyal ENTRY", group=grpE)
eBufPips  = input.float(1.0, "Buffer SL (pips)", minval=0, step=0.1, group=grpE)
eMinRR    = input.float(1.0, "RR minimal ke target (low/high C1)", minval=0, step=0.1, group=grpE)
eWait     = input.int(2, "Maks candle kecil menunggu close setelah sweep", minval=1, maxval=4, group=grpE)
pipIn     = input.float(0, "Ukuran pip (0 = otomatis)", minval=0, group=grpE)
pip       = pipIn > 0 ? pipIn : (syminfo.currency == "JPY" ? 0.01 : 0.0001)

isDaily = mode == "Daily - H6 - M90"
htf = isDaily ? "D" : "240"
mtf = isDaily ? "360" : "60"
ltf = isDaily ? "90" : "15"
mtfName = isDaily ? "H6" : "H1"

if timeframe.in_seconds() > timeframe.in_seconds(ltf)
    runtime.error("Pakai chart " + (isDaily ? "M90" : "M15") + " atau lebih kecil untuk rantai " + mode)

sym = syminfo.tickerid
// Candle HTF sebelumnya (C1) dan open HTF sekarang (C2), tanpa repaint
[pO, pH, pL, pC] = request.security(sym, htf, [open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)
hO = request.security(sym, htf, open, lookahead=barmerge.lookahead_on)
[avgR, low5, high5] = request.security(sym, htf, [ta.sma(high - low, 14)[2], ta.lowest(low, 5)[2], ta.highest(high, 5)[2]], lookahead=barmerge.lookahead_on)
// Candle MTF terakhir yang sudah close
[mO, mH, mL, mC] = request.security(sym, mtf, [open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

newHTF = ta.change(time(htf)) != 0
newMTF = ta.change(time(mtf)) != 0
// Candle kecil (M90/M15) terakhir yang sudah close + candle sebelumnya, dan open MTF yang sedang berjalan
[lO, lH, lL, lC, lHp, lLp] = request.security(sym, ltf, [open[1], high[1], low[1], close[1], high[2], low[2]], lookahead=barmerge.lookahead_on)
newLTF   = ta.change(time(ltf)) != 0
mOpenNow = request.security(sym, mtf, open, lookahead=barmerge.lookahead_on)

f_px(float v) =>
    str.tostring(v, format.mintick)
f_ck(bool b) =>
    b ? "[YA]    " : "[tidak] "

// ---------- Status per candle HTF ----------
var int   mIdx    = 0        // nomor candle MTF yang sedang berjalan di dalam C2 (1..)
var float curHi   = na
var float curLo   = na
// ciri C1 (dihitung saat candle HTF baru dimulai)
var bool  c1WeakBear = false
var bool  c1WeakBull = false
// reversal bullish
var bool  swL = false
var int   swLIdx = 0
var float swLBarHi = na
var bool  fvgB = false
var bool  chB = false
var bool  doneB = false
var int   sigBScore = -1
// reversal bearish
var bool  swH = false
var int   swHIdx = 0
var float swHBarLo = na
var bool  fvgS = false
var bool  chS = false
var bool  doneS = false
var int   sigSScore = -1

// statistik: indeks 0 = skor <=5, 1 = 6-7, 2 = >=8 ; berhasil = C2 close searah reversal
var nB = array.new_int(3, 0)
var wB = array.new_int(3, 0)
var nS = array.new_int(3, 0)
var wS = array.new_int(3, 0)
f_bucket(int sc) =>
    sc >= 8 ? 2 : sc >= 6 ? 1 : 0

// ---------- Candle bayangan: MTF (H6/H1) dan HTF (Daily/H4) digambar di belakang candle kecil ----------
var int   mStartBar = na     // bar pertama candle MTF yang sedang berjalan
var int   mStartT   = na     // waktu (ms) candle MTF yang sedang berjalan dimulai
var int   hStartT   = na     // waktu (ms) candle HTF yang sedang berjalan dimulai
halfBar = timeframe.in_seconds() * 500    // setengah lebar candle chart (ms)
var box   lastBox   = na     // body candle bayangan MTF terakhir
var line  lastWick  = na     // wick candle bayangan MTF terakhir
var label lastTag   = na     // tulisan di atas candle bayangan MTF terakhir
int prevIdx = mIdx            // nomor MTF yang baru saja selesai (kalau newMTF)

// t1 = waktu candle kecil pertama, t2 = waktu candle besar berikutnya dimulai.
// Tepi digeser setengah candle supaya pas di tepi candle kecil, wick tepat di tengah.
f_ghost(int t1, int t2, float o, float h, float l, float c, int transp) =>
    bool  up  = c >= o
    color col = up ? color.green : color.red
    int   xl  = t1 - halfBar
    int   xr  = t2 - halfBar
    int   xm  = math.round((xl + xr) / 2)
    line  w   = line.new(xm, h, xm, l, xloc=xloc.bar_time, color=color.new(col, transp), width=2)
    box   b   = box.new(xl, math.max(o, c), xr, math.min(o, c), xloc=xloc.bar_time, border_color=color.new(col, transp), bgcolor=color.new(col, math.min(97, transp + 40)))
    [b, w, xm]

if showMtf and newMTF and not na(mStartT)
    bool   hadSw = (swL and swLIdx == prevIdx) or (swH and swHIdx == prevIdx)
    string tag   = mtfName + "-" + str.tostring(prevIdx) + (hadSw ? " sweep" : "")
    [gb, gw, gx] = f_ghost(mStartT, time, mO, mH, mL, mC, 55)
    lastBox  := gb
    lastWick := gw
    lastTag  := label.new(gx, mH, tag, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(color.white, 100), textcolor=color.gray, size=size.small)
if showHtf and newHTF and not na(hStartT)
    [hb, hw, hx] = f_ghost(hStartT, time, pO, pH, pL, pC, 80)
if showMtf and newHTF
    line.new(time - halfBar, low, time - halfBar, high, xloc=xloc.bar_time, extend=extend.both, color=color.new(color.gray, 55), style=line.style_dashed)
if newHTF
    hStartT := time
if newMTF
    mStartBar := bar_index
    mStartT   := time

if newHTF
    // catat hasil C2 sebelumnya (yang baru saja close): pO/pC sekarang = C2 tadi
    if sigBScore >= 0
        int b = f_bucket(sigBScore)
        array.set(nB, b, array.get(nB, b) + 1)
        if pC > pO
            array.set(wB, b, array.get(wB, b) + 1)
    if sigSScore >= 0
        int b = f_bucket(sigSScore)
        array.set(nS, b, array.get(nS, b) + 1)
        if pC < pO
            array.set(wS, b, array.get(wS, b) + 1)
    // MTF terakhir dari C1 = mO..mC (baru saja close bersamaan dengan C1)
    float r = mH - mL
    float bodyR = r > 0 ? math.abs(mC - mO) / r : 1
    c1WeakBear := r > 0 and mL <= pL and (bodyR < 0.3 or (math.min(mO, mC) - mL) / r >= 0.4)
    c1WeakBull := r > 0 and mH >= pH and (bodyR < 0.3 or (mH - math.max(mO, mC)) / r >= 0.4)
    mIdx := 1
    curHi := high
    curLo := low
    swL := false
    swH := false
    swLBarHi := na
    swHBarLo := na
    fvgB := false
    fvgS := false
    chB := false
    chS := false
    doneB := false
    doneS := false
    sigBScore := -1
    sigSScore := -1
else
    if newMTF
        mIdx += 1
    curHi := math.max(curHi, high)
    curLo := math.min(curLo, low)

// ---------- Sweep & tanda di TF kecil ----------
if showBull and not doneB and low < pL
    if not swL
        swL := true
        swLIdx := mIdx
        if sweepAlrt
            alert("Sweep LOW C1 " + syminfo.ticker + " (" + mode + "): " + f_px(pL) + " - pantau reversal bullish", alert.freq_once_per_bar)
    if low <= curLo
        swLBarHi := high
if showBear and not doneS and high > pH
    if not swH
        swH := true
        swHIdx := mIdx
        if sweepAlrt
            alert("Sweep HIGH C1 " + syminfo.ticker + " (" + mode + "): " + f_px(pH) + " - pantau reversal bearish", alert.freq_once_per_bar)
    if high >= curHi
        swHBarLo := low
if swL and low > high[2]
    fvgB := true
if swH and high < low[2]
    fvgS := true
if swL and not na(swLBarHi) and close > swLBarHi
    chB := true
if swH and not na(swHBarLo) and close < swHBarLo
    chS := true

// ---------- Pemicu: candle MTF close kembali ke dalam range dan melewati open C2 ----------
pR = pH - pL
c1ClosePct = pR > 0 ? (pC - pL) / pR * 100 : 50.0

if newMTF and not newHTF and swL and not doneB and showBull and mC > pL and mC > hO
    bool k1 = pC < pO
    bool k2 = c1ClosePct <= closeZone
    bool k3 = c1WeakBear
    bool k4 = pR >= climaxK * avgR
    bool k5 = pL < low5
    bool k6 = true
    bool k7 = swLIdx <= 2
    bool k8 = true
    bool k9 = fvgB
    bool k10 = chB
    int sc = (k1 ? 1 : 0) + (k2 ? 1 : 0) + (k3 ? 1 : 0) + (k4 ? 1 : 0) + (k5 ? 1 : 0) + (k6 ? 1 : 0) + (k7 ? 1 : 0) + (k8 ? 1 : 0) + (k9 ? 1 : 0) + (k10 ? 1 : 0)
    doneB := true
    if k1 and sc >= minScore
        sigBScore := sc
        string chk = "\n" + f_ck(k1) + "C1 bearish\n" + f_ck(k2) + "C1 close " + str.tostring(c1ClosePct, "#") + "% (dekat low)\n" + f_ck(k3) + "C1 berakhir lemah\n" + f_ck(k4) + "C1 klimaks\n" + f_ck(k5) + "low C1 = low 5 candle\n" + f_ck(k6) + "sweep low C1 " + f_px(pL) + "\n" + f_ck(k7) + "sweep di MTF ke-" + str.tostring(swLIdx) + "\n" + f_ck(k8) + "MTF close > low C1 & > open\n" + f_ck(k9) + "FVG bullish TF kecil\n" + f_ck(k10) + "struktur TF kecil berubah"
        string tip = "REVERSAL BULLISH  skor " + str.tostring(sc) + "/10\n" + mode + " | MTF ke-" + str.tostring(mIdx - 1) + " close " + f_px(mC) + chk
        if showMtf and not na(lastBox)
            label.set_text(lastTag, mtfName + "-" + str.tostring(prevIdx) + (swLIdx == prevIdx ? " sweep +" : "") + " PEMICU BUY")
            label.set_textcolor(lastTag, color.green)
            box.set_border_color(lastBox, color.green)
            box.set_border_width(lastBox, 2)
            line.set_color(lastWick, color.green)
        label.new(bar_index - 1, mL, "BUY " + str.tostring(sc), style=label.style_label_up, color=sc >= 8 ? color.green : sc >= 6 ? color.new(color.green, 30) : color.new(color.green, 55), textcolor=color.white, size=size.small, tooltip=tip)
        alert(syminfo.ticker + " REVERSAL BULLISH skor " + str.tostring(sc) + "/10 (" + mode + "): sweep low C1 " + f_px(pL) + ", MTF close " + f_px(mC) + " > open " + f_px(hO), alert.freq_once_per_bar)

if newMTF and not newHTF and swH and not doneS and showBear and mC < pH and mC < hO
    bool k1 = pC > pO
    bool k2 = c1ClosePct >= 100 - closeZone
    bool k3 = c1WeakBull
    bool k4 = pR >= climaxK * avgR
    bool k5 = pH > high5
    bool k6 = true
    bool k7 = swHIdx <= 2
    bool k8 = true
    bool k9 = fvgS
    bool k10 = chS
    int sc = (k1 ? 1 : 0) + (k2 ? 1 : 0) + (k3 ? 1 : 0) + (k4 ? 1 : 0) + (k5 ? 1 : 0) + (k6 ? 1 : 0) + (k7 ? 1 : 0) + (k8 ? 1 : 0) + (k9 ? 1 : 0) + (k10 ? 1 : 0)
    doneS := true
    if k1 and sc >= minScore
        sigSScore := sc
        string chk = "\n" + f_ck(k1) + "C1 bullish\n" + f_ck(k2) + "C1 close " + str.tostring(c1ClosePct, "#") + "% (dekat high)\n" + f_ck(k3) + "C1 berakhir lemah\n" + f_ck(k4) + "C1 klimaks\n" + f_ck(k5) + "high C1 = high 5 candle\n" + f_ck(k6) + "sweep high C1 " + f_px(pH) + "\n" + f_ck(k7) + "sweep di MTF ke-" + str.tostring(swHIdx) + "\n" + f_ck(k8) + "MTF close < high C1 & < open\n" + f_ck(k9) + "FVG bearish TF kecil\n" + f_ck(k10) + "struktur TF kecil berubah"
        string tip = "REVERSAL BEARISH  skor " + str.tostring(sc) + "/10\n" + mode + " | MTF ke-" + str.tostring(mIdx - 1) + " close " + f_px(mC) + chk
        if showMtf and not na(lastBox)
            label.set_text(lastTag, mtfName + "-" + str.tostring(prevIdx) + (swHIdx == prevIdx ? " sweep +" : "") + " PEMICU SELL")
            label.set_textcolor(lastTag, color.red)
            box.set_border_color(lastBox, color.red)
            box.set_border_width(lastBox, 2)
            line.set_color(lastWick, color.red)
        label.new(bar_index - 1, mH, "SELL " + str.tostring(sc), style=label.style_label_down, color=sc >= 8 ? color.red : sc >= 6 ? color.new(color.red, 30) : color.new(color.red, 55), textcolor=color.white, size=size.small, tooltip=tip)
        alert(syminfo.ticker + " REVERSAL BEARISH skor " + str.tostring(sc) + "/10 (" + mode + "): sweep high C1 " + f_px(pH) + ", MTF close " + f_px(mC) + " < open " + f_px(hO), alert.freq_once_per_bar)

// ---------- ENTRY: bias dari MTF, entry dari sweep candle kecil di MTF berikutnya ----------
// SELL: (1) candle MTF menyapu high C1 lalu close bearish kembali di bawahnya = BIAS
//       (2) di candle MTF berikutnya, candle kecil menyapu high candle kecil sebelumnya
//       (3) candle kecil close bearish di bawah open MTF dan di bawah high yang disapu
//           (maks eWait candle setelah sweep) = ENTRY. SL di atas ujung sweep, target low C1.
// BUY kebalikannya.
var bool  biasS = false
var int   biasSIdx = 0
var float biasSTop = na
var bool  entS = false
var int   cntS = -1
var float swHiS = na
var float swLvS = na
var bool  biasB = false
var int   biasBIdx = 0
var float biasBBot = na
var bool  entB = false
var int   cntB = -1
var float swLoB = na
var float swLvB = na
// posisi simulasi untuk statistik
var bool  inT = false
var bool  tSell = false
var float tE = na
var float tSL = na
var float tTg = na
var float tR = na
var int   tBar = 0
var eN  = array.new_int(2, 0)       // 0 = BUY, 1 = SELL
var eW  = array.new_int(2, 0)
var eRs = array.new_float(2, 0.0)

f_closeT(float r) =>
    int k = tSell ? 1 : 0
    array.set(eN, k, array.get(eN, k) + 1)
    array.set(eRs, k, array.get(eRs, k) + r)
    if r > 0
        array.set(eW, k, array.get(eW, k) + 1)

// kelola posisi simulasi
if inT and bar_index > tBar
    if newHTF
        f_closeT(((tSell ? tE - open : open - tE)) / tR)
        inT := false
    else if tSell ? high >= tSL : low <= tSL
        f_closeT(-1.0)
        inT := false
    else if tSell ? low <= tTg : high >= tTg
        f_closeT(math.abs(tE - tTg) / tR)
        inT := false

if newHTF
    biasS := false
    entS := false
    cntS := -1
    biasB := false
    entB := false
    cntB := -1
else if useEntry
    // (1) bias dari candle MTF yang baru close
    if newMTF
        if not biasS and mH > pH and mC < pH and mC < mO
            biasS := true
            biasSIdx := prevIdx
            biasSTop := curHi
        if not biasB and mL < pL and mC > pL and mC > mO
            biasB := true
            biasBIdx := prevIdx
            biasBBot := curLo
    // bias batal kalau harga menembus ujung sweep MTF
    if biasS and close > biasSTop
        biasS := false
    if biasB and close < biasBBot
        biasB := false
    // (2)+(3) sweep candle kecil dan close konfirmasi di MTF berikutnya
    if newLTF
        int   compIdx = newMTF ? prevIdx : mIdx
        float mOpenC  = newMTF ? mO : mOpenNow
        float buf     = eBufPips * pip
        if biasS and not entS and compIdx > biasSIdx
            if lH > lHp
                cntS := 0
                swHiS := lH
                swLvS := lHp
            else if cntS >= 0
                cntS += 1
                swHiS := math.max(swHiS, lH)
            if cntS >= 0 and cntS < eWait and lC < lO and lC < mOpenC and lC < swLvS
                float e  = lC
                float sl = swHiS + buf
                float r  = sl - e
                float rr = r > 0 ? (e - pL) / r : 0
                if r > 0 and rr >= eMinRR
                    entS := true
                    if not inT
                        inT := true
                        tSell := true
                        tE := e
                        tSL := sl
                        tTg := pL
                        tR := r
                        tBar := bar_index
                    string tx = "ENTRY SELL\nE " + f_px(e) + "  SL " + f_px(sl) + "\nTarget " + f_px(pL) + " (" + str.tostring(rr, "#.#") + "R)"
                    label.new(bar_index - 1, lH, tx, style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.small)
                    box.new(bar_index, sl, bar_index + 8, e, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))
                    box.new(bar_index, e, bar_index + 8, pL, border_color=color.new(color.teal, 60), bgcolor=color.new(color.teal, 85))
                    alert(syminfo.ticker + " ENTRY SELL (" + mode + "): entry " + f_px(e) + ", SL " + f_px(sl) + ", target " + f_px(pL) + " (" + str.tostring(rr, "#.#") + "R)", alert.freq_once_per_bar)
                cntS := -1
            if cntS >= eWait
                cntS := -1
        if biasB and not entB and compIdx > biasBIdx
            if lL < lLp
                cntB := 0
                swLoB := lL
                swLvB := lLp
            else if cntB >= 0
                cntB += 1
                swLoB := math.min(swLoB, lL)
            if cntB >= 0 and cntB < eWait and lC > lO and lC > mOpenC and lC > swLvB
                float e  = lC
                float sl = swLoB - buf
                float r  = e - sl
                float rr = r > 0 ? (pH - e) / r : 0
                if r > 0 and rr >= eMinRR
                    entB := true
                    if not inT
                        inT := true
                        tSell := false
                        tE := e
                        tSL := sl
                        tTg := pH
                        tR := r
                        tBar := bar_index
                    string tx = "ENTRY BUY\nE " + f_px(e) + "  SL " + f_px(sl) + "\nTarget " + f_px(pH) + " (" + str.tostring(rr, "#.#") + "R)"
                    label.new(bar_index - 1, lL, tx, style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.small)
                    box.new(bar_index, e, bar_index + 8, sl, border_color=color.new(color.red, 60), bgcolor=color.new(color.red, 85))
                    box.new(bar_index, pH, bar_index + 8, e, border_color=color.new(color.teal, 60), bgcolor=color.new(color.teal, 85))
                    alert(syminfo.ticker + " ENTRY BUY (" + mode + "): entry " + f_px(e) + ", SL " + f_px(sl) + ", target " + f_px(pH) + " (" + str.tostring(rr, "#.#") + "R)", alert.freq_once_per_bar)
                cntB := -1
            if cntB >= eWait
                cntB := -1

// ---------- Gambar ----------
plot(showLvl ? pH : na, "High C1", color=color.new(color.red, 30), style=plot.style_stepline)
plot(showLvl ? pL : na, "Low C1", color=color.new(color.green, 30), style=plot.style_stepline)
plot(showLvl ? hO : na, "Open C2", color=color.new(color.blue, 30), style=plot.style_stepline)

// ---------- Tabel statistik (ringkas) ----------
// Persentase = seberapa sering candle HTF (C2) akhirnya close searah sinyal; angka dalam kurung = jumlah sinyal
var table ts = table.new(position.bottom_right, 3, 4, bgcolor=color.new(color.black, 20), border_width=1)
f_cell(int w, int n) =>
    n > 0 ? str.tostring(100.0 * w / n, "#") + "% (" + str.tostring(n) + ")" : "-"
if barstate.islast
    table.clear(ts, 0, 0, 2, 3)
    table.cell(ts, 0, 0, "Skor", text_color=color.yellow, text_size=size.small)
    table.cell(ts, 1, 0, "BUY benar", text_color=color.lime, text_size=size.small)
    table.cell(ts, 2, 0, "SELL benar", text_color=color.red, text_size=size.small)
    nm = array.from("8-10", "6-7", "5 ke bawah")
    for k = 0 to 2
        int j = 2 - k
        table.cell(ts, 0, k + 1, array.get(nm, k), text_color=color.white, text_size=size.small)
        table.cell(ts, 1, k + 1, f_cell(array.get(wB, j), array.get(nB, j)), text_color=color.white, text_size=size.small)
        table.cell(ts, 2, k + 1, f_cell(array.get(wS, j), array.get(nS, j)), text_color=color.white, text_size=size.small)

// ---------- Tabel hasil ENTRY (simulasi: SL di ujung sweep, target low/high C1, tutup saat candle HTF close) ----------
var table te = table.new(position.top_right, 4, 3, bgcolor=color.new(color.black, 20), border_width=1)
if useEntry and barstate.islast
    table.clear(te, 0, 0, 3, 2)
    table.cell(te, 0, 0, "ENTRY", text_color=color.yellow, text_size=size.small)
    table.cell(te, 1, 0, "Trade", text_color=color.yellow, text_size=size.small)
    table.cell(te, 2, 0, "Menang", text_color=color.yellow, text_size=size.small)
    table.cell(te, 3, 0, "Total R", text_color=color.yellow, text_size=size.small)
    for k = 0 to 1
        int   n_ = array.get(eN, k)
        float r_ = array.get(eRs, k)
        table.cell(te, 0, k + 1, k == 0 ? "BUY" : "SELL", text_color=k == 0 ? color.lime : color.red, text_size=size.small)
        table.cell(te, 1, k + 1, str.tostring(n_), text_color=color.white, text_size=size.small)
        table.cell(te, 2, k + 1, n_ > 0 ? str.tostring(100.0 * array.get(eW, k) / n_, "#") + "%" : "-", text_color=color.white, text_size=size.small)
        table.cell(te, 3, k + 1, str.tostring(r_, "#.#"), text_color=r_ >= 0 ? color.lime : color.red, text_size=size.small)
