//@version=5
// CRT sesi New York 09:00 - aturan sama dengan bot/strategy.py (jurnal-trading)
// Pasang di chart M30. Semua jam = waktu New York (DST otomatis).
//
// SELL (BUY kebalikannya):
// 1. Referensi : high/low candle H4 sebelum sesi (default H4 05:00)
// 2. Sweep     : candle H1 di jendela H4 sesi (09:00-12:00) menembus HIGH
//                referensi lalu close BEARISH kembali di bawah high.
//                Sisi yang tersapu pertama menentukan bias.
// 3. Target    : swing low H1 terdekat (fractal 3 candle). Swing bersih
//                diutamakan, equal lows dipakai kalau tidak ada.
// 4. Filter    : tidak boleh ada FVG bullish di H1 dari swing target
//                sampai candle sweep, sekecil apa pun (termasuk FVG yang
//                candle tengahnya adalah candle swing).
// 5. Entry     : close candle H1 sweep. SL = high M30 terakhir + buffer.
//                Batal kalau M30 terakhir menyapu low M30 sebelumnya dan
//                close bullish (CRT M30 melawan arah).
// 6. Filter    : target harus >= 1R.
// 7. Kelola    : 2 order @ setengah risiko. A = TP 1:1. Setelah A kena,
//                SL B pindah ke entry. Semua posisi ditutup jam 13:00.
strategy("CRT NY 09:00 (jurnal-trading)", shorttitle="CRT 9AM", overlay=true, pyramiding=2,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=false, max_labels_count=500)

// ---------- Pengaturan ----------
pipSize   = input.float(0.0001, "Ukuran pip", tooltip="EURUSD 0.0001, pair JPY 0.01")
slBufPips = input.float(1.0, "Buffer SL (pips)", minval=0)
minRR     = input.float(1.0, "Target minimal (R)", minval=0)
riskPct   = input.float(0.5, "Risiko total per setup (%)", minval=0.01)
runnerH   = input.int(0, "VARIASI: tahan Order B sampai jam (0 = mati)", minval=0, maxval=23)
lookback  = input.int(48, "Cari swing H1 ke belakang (candle)", minval=5)
m30Filter = input.bool(true, "Filter CRT M30 melawan arah")
showSkip  = input.bool(true, "Tampilkan label alasan setup batal")

TZ      = "America/New_York"
sessH   = 9          // HANYA sesi H4 09:00 New York (referensi H4 05:00, tutup 13:00)
refH    = sessH - 4
closeH  = sessH + 4
bCloseH = runnerH > closeH ? runnerH : closeH

if timeframe.period != "30"
    runtime.error("Pakai chart M30 (30 menit).")

nyH    = hour(time, TZ)
nyM    = minute(time, TZ)
dayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
endMin = nyH * 60 + nyM + 30   // menit (jam NY) saat candle M30 ini close

// ---------- Susun candle H1 dari M30 ----------
var a_o  = array.new_float()
var a_h  = array.new_float()
var a_l  = array.new_float()
var a_c  = array.new_float()
var a_hr = array.new_int()
var a_dk = array.new_int()

var float cO  = na
var float cH  = na
var float cL  = na
var float cC  = na
var int   cHr = -1
var int   cDk = -1

h1Done = false
if nyM == 0
    cO  := open
    cH  := high
    cL  := low
    cC  := close
    cHr := nyH
    cDk := dayKey
else if nyM == 30
    if cHr == nyH and cDk == dayKey
        cH := math.max(cH, high)
        cL := math.min(cL, low)
        cC := close
    else
        cO  := open
        cH  := high
        cL  := low
        cC  := close
        cHr := nyH
        cDk := dayKey
    array.push(a_o, cO)
    array.push(a_h, cH)
    array.push(a_l, cL)
    array.push(a_c, cC)
    array.push(a_hr, cHr)
    array.push(a_dk, cDk)
    h1Done := true
    if array.size(a_o) > 400
        array.shift(a_o)
        array.shift(a_h)
        array.shift(a_l)
        array.shift(a_c)
        array.shift(a_hr)
        array.shift(a_dk)

n = array.size(a_o)

// ---------- Status hari & trade ----------
var float  refHi   = na
var float  refLo   = na
var int    sDay    = -1
var string bias    = ""
var bool   dayDone = true

var bool   inTrade = false
var bool   aOpen   = false
var bool   bOpen   = false
var int    eBar    = 0
var int    tDay    = -1
var int    tYear   = 0
var string tSide   = ""
var float  tE      = na
var float  tSL     = na
var float  tTP     = na
var float  tSLB    = na
var float  tR      = na
var float  rA      = na
var float  rB      = na
var int    aRes    = 0      // 1 TP1, -1 SL, 0 tutup jam

// statistik (dalam R; 1R = risiko total per setup)
var int   nTr   = 0
var int   nTP   = 0
var int   nSL   = 0
var int   nTO   = 0
var int   nFvg  = 0
var int   nRR   = 0
var int   nM30  = 0
var float totR  = 0.0
var float eqR   = 0.0
var float pkR   = 0.0
var float ddR   = 0.0
var int   curLs = 0
var int   maxLs = 0
var yrs = array.new_int()
var yrR = array.new_float()
var yrN = array.new_int()

// ---------- Fungsi ----------
f_target(bool isSell, int trig, float entry, bool allowEq) =>
    int   idx = -1
    float px  = na
    int   lo  = math.max(1, trig - lookback)
    if trig - 1 >= lo
        for i = trig - 1 to lo
            float v  = isSell ? array.get(a_l, i)     : array.get(a_h, i)
            float vl = isSell ? array.get(a_l, i - 1) : array.get(a_h, i - 1)
            float vr = isSell ? array.get(a_l, i + 1) : array.get(a_h, i + 1)
            bool okL = isSell ? (allowEq ? v <= vl : v < vl) : (allowEq ? v >= vl : v > vl)
            bool okR = isSell ? v < vr : v > vr
            bool beyond = isSell ? v < entry : v > entry
            if okL and okR and beyond
                idx := i
                px  := v
                break
    [idx, px]

f_fvg(bool isSell, int fromI, int toI) =>
    bool found = false
    if toI - fromI >= 2
        for k = fromI to toI - 2
            bool g = isSell ? array.get(a_h, k) < array.get(a_l, k + 2) : array.get(a_l, k) > array.get(a_h, k + 2)
            if g
                found := true
                break
    found

f_skip(string txt) =>
    if showSkip
        label.new(bar_index, high, txt, style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny)

// ---------- Kelola trade yang sedang berjalan ----------
if inTrade and bar_index >= eBar
    bool isS    = tSide == "SELL"
    bool aTpNow = false
    if aOpen
        if isS ? high >= tSL : low <= tSL
            rA    := -1.0
            aRes  := -1
            aOpen := false
        else if isS ? low <= tTP : high >= tTP
            rA     := 1.0
            aRes   := 1
            aOpen  := false
            aTpNow := true
    if bOpen and (isS ? high >= tSLB : low <= tSLB)
        rB    := (isS ? tE - tSLB : tSLB - tE) / tR
        bOpen := false
    if aTpNow and bOpen
        tSLB := tE
        strategy.exit("XB", "B", stop=tE)
    float rNow = (isS ? tE - close : close - tE) / tR
    bool newDay = dayKey != tDay
    if aOpen and (endMin >= closeH * 60 or newDay)
        rA    := rNow
        aRes  := 0
        aOpen := false
        strategy.close("A", comment="tutup jam")
    if bOpen and (endMin >= bCloseH * 60 or newDay)
        rB    := rNow
        bOpen := false
        strategy.close("B", comment="tutup jam")
    if not aOpen and not bOpen
        inTrade := false
        float tot = (rA + rB) / 2
        nTr  += 1
        nTP  += aRes == 1 ? 1 : 0
        nSL  += aRes == -1 ? 1 : 0
        nTO  += aRes == 0 ? 1 : 0
        totR += tot
        eqR  += tot
        pkR  := math.max(pkR, eqR)
        ddR  := math.max(ddR, pkR - eqR)
        curLs := tot < 0 ? curLs + 1 : 0
        maxLs := math.max(maxLs, curLs)
        int yi = array.indexof(yrs, tYear)
        if yi == -1
            array.push(yrs, tYear)
            array.push(yrR, tot)
            array.push(yrN, 1)
        else
            array.set(yrR, yi, array.get(yrR, yi) + tot)
            array.set(yrN, yi, array.get(yrN, yi) + 1)

// ---------- Candle referensi H4 (4 candle H1 sebelum sesi) ----------
if h1Done and cHr == sessH - 1 and n >= 4
    if array.get(a_hr, n - 4) == refH and array.get(a_dk, n - 4) == dayKey
        refHi   := math.max(math.max(array.get(a_h, n - 4), array.get(a_h, n - 3)), math.max(array.get(a_h, n - 2), array.get(a_h, n - 1)))
        refLo   := math.min(math.min(array.get(a_l, n - 4), array.get(a_l, n - 3)), math.min(array.get(a_l, n - 2), array.get(a_l, n - 1)))
        sDay    := dayKey
        bias    := ""
        dayDone := false

// ---------- Cari setup di candle H1 jendela sesi ----------
if h1Done and sDay == dayKey and not dayDone and not inTrade and cHr >= sessH and cHr < sessH + 4
    int   trig = n - 1
    float bo = array.get(a_o, trig)
    float bh = array.get(a_h, trig)
    float bl = array.get(a_l, trig)
    float bc = array.get(a_c, trig)
    bool hiSw = bh > refHi
    bool loSw = bl < refLo
    if bias == ""
        if hiSw and loSw
            dayDone := true
            f_skip("Dua sisi tersapu")
        else if hiSw
            bias := "SELL"
        else if loSw
            bias := "BUY"
    bool isSell = bias == "SELL"
    bool swept  = isSell ? hiSw : loSw
    if not dayDone and bias != "" and swept
        bool validClose = isSell ? (bc < bo and bc < refHi) : (bc > bo and bc > refLo)
        if validClose
            if cHr + 1 >= closeH
                f_skip("Terlambat")
            else
                float entry = bc
                float buf   = slBufPips * pipSize
                float sl    = isSell ? high + buf : low - buf   // candle M30 terakhir = candle ini
                float risk  = math.abs(sl - entry)
                [ti1, px1] = f_target(isSell, trig, entry, false)
                [ti2, px2] = f_target(isSell, trig, entry, true)
                int   tgtI = ti1 != -1 ? ti1 : ti2
                float tgtP = ti1 != -1 ? px1 : px2
                bool m30Counter = m30Filter and (isSell ? (low < low[1] and close > open) : (high > high[1] and close < open))
                if risk <= 0
                    f_skip("SL tidak valid")
                else if m30Counter
                    nM30 += 1
                    f_skip("M30 melawan")
                else if tgtI == -1
                    f_skip("Tidak ada swing")
                else if f_fvg(isSell, math.max(0, tgtI - 1), trig)
                    nFvg += 1
                    f_skip("FVG berlawanan")
                else if math.abs(tgtP - entry) / risk < minRR
                    nRR += 1
                    f_skip("RR < " + str.tostring(minRR))
                else
                    inTrade := true
                    aOpen   := true
                    bOpen   := true
                    eBar    := bar_index + 1
                    tDay    := dayKey
                    tYear   := year(time, TZ)
                    tSide   := bias
                    tE      := entry
                    tSL     := sl
                    tSLB    := sl
                    tR      := risk
                    tTP     := isSell ? entry - risk : entry + risk
                    rA      := na
                    rB      := na
                    dayDone := true
                    float qty = (strategy.initial_capital * riskPct / 200) / risk
                    dir = isSell ? strategy.short : strategy.long
                    strategy.entry("A", dir, qty=qty)
                    strategy.entry("B", dir, qty=qty)
                    strategy.exit("XA", "A", stop=sl, limit=tTP)
                    strategy.exit("XB", "B", stop=sl)
                    string txt = (isSell ? "SELL" : "BUY") + "\nEntry " + str.tostring(entry, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " (" + str.tostring(risk / pipSize, "#.#") + " pips)" + "\nTP1 " + str.tostring(tTP, format.mintick) + "\nSwing " + str.tostring(tgtP, format.mintick) + " (" + str.tostring(math.abs(tgtP - entry) / risk, "#.##") + "R)"
                    label.new(bar_index, isSell ? high : low, txt, style=isSell ? label.style_label_down : label.style_label_up, color=isSell ? color.red : color.green, textcolor=color.white, size=size.small)

// ---------- Gambar ----------
inSess = sDay == dayKey and nyH >= sessH and nyH < closeH
plot(inSess ? refHi : na, "High referensi", color=color.blue, style=plot.style_linebr)
plot(inSess ? refLo : na, "Low referensi", color=color.blue, style=plot.style_linebr)
plot(inTrade ? tSLB : na, "SL", color=color.red, style=plot.style_linebr)
plot(inTrade and aOpen ? tTP : na, "TP1", color=color.green, style=plot.style_linebr)

// ---------- Tabel hasil (dalam R) ----------
var table tb = table.new(position.top_right, 3, 30, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 2, 29)
    table.cell(tb, 0, 0, "CRT NY " + str.tostring(sessH) + ":00", text_color=color.white)
    table.cell(tb, 0, 1, "Setup valid", text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(nTr), text_color=color.white)
    table.cell(tb, 0, 2, "Kena TP1 (1:1)", text_color=color.white)
    table.cell(tb, 1, 2, str.tostring(nTP), text_color=color.lime)
    table.cell(tb, 2, 2, nTr > 0 ? str.tostring(100.0 * nTP / nTr, "#") + "%" : "-", text_color=color.lime)
    table.cell(tb, 0, 3, "Kena SL", text_color=color.white)
    table.cell(tb, 1, 3, str.tostring(nSL), text_color=color.red)
    table.cell(tb, 2, 3, nTr > 0 ? str.tostring(100.0 * nSL / nTr, "#") + "%" : "-", text_color=color.red)
    table.cell(tb, 0, 4, "Tutup jam " + str.tostring(closeH), text_color=color.white)
    table.cell(tb, 1, 4, str.tostring(nTO), text_color=color.white)
    table.cell(tb, 0, 5, "Total R", text_color=color.white)
    table.cell(tb, 1, 5, str.tostring(totR, "#.##"), text_color=totR >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 6, "R per setup", text_color=color.white)
    table.cell(tb, 1, 6, nTr > 0 ? str.tostring(totR / nTr, "#.###") : "-", text_color=color.white)
    table.cell(tb, 0, 7, "Drawdown maks (R)", text_color=color.white)
    table.cell(tb, 1, 7, str.tostring(ddR, "#.##"), text_color=color.orange)
    table.cell(tb, 0, 8, "Kalah beruntun maks", text_color=color.white)
    table.cell(tb, 1, 8, str.tostring(maxLs), text_color=color.orange)
    table.cell(tb, 0, 9, "Batal: FVG / RR<1 / M30", text_color=color.white)
    table.cell(tb, 1, 9, str.tostring(nFvg) + " / " + str.tostring(nRR) + " / " + str.tostring(nM30), text_color=color.gray)
    table.cell(tb, 0, 10, "Tahun", text_color=color.yellow)
    table.cell(tb, 1, 10, "R", text_color=color.yellow)
    table.cell(tb, 2, 10, "Setup", text_color=color.yellow)
    int ny = array.size(yrs)
    int st = math.max(0, ny - 18)
    if ny > 0
        for j = st to ny - 1
            int row = 11 + j - st
            float yr = array.get(yrR, j)
            table.cell(tb, 0, row, str.tostring(array.get(yrs, j)), text_color=color.white)
            table.cell(tb, 1, row, str.tostring(yr, "#.##"), text_color=yr >= 0 ? color.lime : color.red)
            table.cell(tb, 2, row, str.tostring(array.get(yrN, j)), text_color=color.white)
