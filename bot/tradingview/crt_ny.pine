//@version=5
// CRT berbasis candle H4 New York - aturan sama dengan bot/strategy.py (jurnal-trading)
// Pasang di chart M30. Semua jam = waktu New York (DST otomatis).
// Candle H4 NY: 01, 05, 09, 13, 17, 21.
//
// Mode "09:00 saja" = SOP utama (referensi H4 05:00, sesi H4 09:00, tutup 13:00).
// Mode "Semua H4"   = setiap candle H4 jadi referensi untuk candle H4 berikutnya.
//
// SELL (BUY kebalikannya):
// 1. Referensi : high/low candle H4 sebelumnya.
// 2. Sweep     : candle H1 di dalam candle H4 sesi menembus HIGH referensi
//                lalu close BEARISH kembali di bawah high.
//                Sisi yang tersapu pertama menentukan bias.
// 3. Target    : swing low H1 terdekat (fractal 3 candle). Swing bersih
//                diutamakan, equal lows dipakai kalau tidak ada.
// 4. Filter    : tidak boleh ada FVG bullish di H1 dari swing target
//                sampai candle sweep, sekecil apa pun (termasuk FVG yang
//                candle tengahnya adalah candle swing).
// 5. Entry     : close candle H1 sweep. SL = high M30 terakhir + buffer.
//                Kalau M30 terakhir menyapu low M30 sebelumnya dan close
//                bullish (CRT M30 melawan), tunggu maks 2 candle M30 yang
//                close bearish (tanpa menembus high sweep); entry di close
//                candle itu, SL di high-nya. Kalau tidak ada -> batal.
// 6. Filter    : target harus >= 1R.
// 7. Kelola    : 2 order @ setengah risiko. A = TP 1:1 (bisa diubah, desimal). Setelah A kena,
//                SL B pindah ke entry. Semua posisi ditutup saat candle H4
//                sesi close (sesi 09:00 -> jam 13:00).
strategy("CRT NY (jurnal-trading)", shorttitle="CRT NY", overlay=true, pyramiding=2,
     initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=false, max_labels_count=500, max_lines_count=500)

// ---------- Pengaturan ----------
modeSel   = input.string("09:00 saja (SOP)", "Sesi", options=["09:00 saja (SOP)", "Semua H4 (tiap 4 jam)"])
pipSize   = input.float(0.0001, "Ukuran pip", tooltip="EURUSD 0.0001, pair JPY 0.01")
slBufPips = input.float(1.0, "Buffer SL (pips)", minval=0)
minRR     = input.float(1.0, "Target swing minimal (R)", minval=0, step=0.1, tooltip="Boleh desimal, misal 1.5")
tpRR      = input.float(1.0, "TP Order A (R)", minval=0.1, step=0.1, tooltip="1 = TP 1:1. Boleh desimal, misal 1.5. Setelah TP ini kena, SL Order B pindah ke entry.")
riskPct   = input.float(0.5, "Risiko total per setup (%)", minval=0.01)
minSlPips = input.float(3.0, "SL minimal (pips)", minval=0, step=0.5, tooltip="SL lebih kecil dari ini -> setup batal")
sprPips   = input.float(1.0, "Spread (pips)", minval=0, step=0.1, tooltip="Biaya spread. Data chart = harga bid; BUY masuk di ask, SELL keluar di ask.")
runnerX   = input.int(0, "VARIASI: tahan Order B +jam setelah sesi tutup (0 = mati)", minval=0, maxval=12)
lookback  = input.int(48, "Cari swing H1 ke belakang (candle)", minval=5)
m30Filter = input.bool(true, "Filter CRT M30 melawan arah")
openFilt  = input.bool(false, "VARIASI: SELL hanya di atas open H4 sesi, BUY di bawahnya")
maxTrigH1 = input.int(4, "VARIASI: pemicu hanya dari H1 ke-1..N di sesi (4 = semua)", minval=1, maxval=4)

// ---------- Pengaturan monitor likuiditas ----------
grpL      = "Monitor likuiditas (level fresh)"
liqOn     = input.bool(true, "Aktifkan monitor likuiditas", group=grpL)
daysBack  = input.int(3, "Simpan level berapa hari ke belakang", minval=1, maxval=20, group=grpL)
useDay    = input.bool(true, "High/low harian (PDH/PDL)", group=grpL)
useWeek   = input.bool(true, "High/low minggu lalu (PWH/PWL)", group=grpL)
useAsia   = input.bool(true, "High/low sesi Asia", group=grpL)
asiaSess  = input.session("2000-2359", "Jam sesi Asia (NY)", group=grpL)
useLon    = input.bool(true, "High/low sesi London", group=grpL)
lonSess   = input.session("0200-0500", "Jam sesi London (NY)", group=grpL)
useEq     = input.bool(true, "Equal highs/lows (swing H1)", group=grpL)
eqTolPips = input.float(1.0, "Toleransi equal (pips)", minval=0, step=0.1, group=grpL)
showLvl   = input.bool(false, "Gambar garis level fresh", group=grpL)
minLoc    = input.int(0, "Filter: minimal level fresh tersapu di sisi sweep (0 = mati)", minval=0, group=grpL)

showRef   = input.bool(true, "Gambar high/low referensi")
showSkip  = input.bool(true, "Tampilkan label alasan setup batal")

TZ     = "America/New_York"
HOUR   = 3600000
allH4  = modeSel == "Semua H4 (tiap 4 jam)"

if timeframe.period != "30"
    runtime.error("Pakai chart M30 (30 menit).")

nyH    = hour(time, TZ)
nyM    = minute(time, TZ)
barEnd = time + 30 * 60000

// ---------- Susun candle H1 dari M30 ----------
var a_o  = array.new_float()
var a_h  = array.new_float()
var a_l  = array.new_float()
var a_c  = array.new_float()
var a_hr = array.new_int()
var a_t  = array.new_int()     // jam buka candle H1 (ms)

var float cO  = na
var float cH  = na
var float cL  = na
var float cC  = na
var int   cHr = -1
var int   cT  = 0

h1Done = false
if nyM == 0
    cO  := open
    cH  := high
    cL  := low
    cC  := close
    cHr := nyH
    cT  := time
else if nyM == 30
    if cHr == nyH and time - cT == 30 * 60000
        cH := math.max(cH, high)
        cL := math.min(cL, low)
        cC := close
    else
        cO  := open
        cH  := high
        cL  := low
        cC  := close
        cHr := nyH
        cT  := time - 30 * 60000
    array.push(a_o, cO)
    array.push(a_h, cH)
    array.push(a_l, cL)
    array.push(a_c, cC)
    array.push(a_hr, cHr)
    array.push(a_t, cT)
    h1Done := true
    if array.size(a_o) > 400
        array.shift(a_o)
        array.shift(a_h)
        array.shift(a_l)
        array.shift(a_c)
        array.shift(a_hr)
        array.shift(a_t)

n = array.size(a_o)

// ---------- Monitor likuiditas: level fresh & yang sudah tersapu ----------
var lp    = array.new_float()    // harga level
var lname = array.new_string()   // nama level
var lhigh = array.new_bool()     // true = level atas (high)
var lt    = array.new_int()      // waktu level dibuat
var lfr   = array.new_bool()     // masih fresh?
var lst   = array.new_int()      // waktu tersapu
var lln   = array.new_line()     // garis di chart
var string h1Swept   = ""        // level tersapu di candle H1 yang sedang berjalan
var string lastSwept = ""        // level tersapu di candle H1 terakhir yang sudah close
var int    lastH1T   = 0

f_push(float price, string name, bool isHigh) =>
    if liqOn and not na(price)
        array.push(lp, price)
        array.push(lname, name)
        array.push(lhigh, isHigh)
        array.push(lt, time)
        array.push(lfr, true)
        array.push(lst, 0)
        line ln = na
        if showLvl
            ln := line.new(bar_index, price, bar_index + 1, price, extend=extend.right, color=isHigh ? color.new(color.red, 40) : color.new(color.green, 40), style=line.style_dotted)
        array.push(lln, ln)

// High/low harian (hari forex mulai 17:00 NY) dan mingguan
var float dHi = na
var float dLo = na
var int   dT  = 0
var float wHi = na
var float wLo = na
if timeframe.change("D")
    if useDay and not na(dHi)
        string tg = str.format_time(dT, "dd/MM", TZ)
        f_push(dHi, "PDH " + tg, true)
        f_push(dLo, "PDL " + tg, false)
    dHi := high
    dLo := low
    dT  := time
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
if timeframe.change("W")
    if useWeek and not na(wHi)
        f_push(wHi, "PWH", true)
        f_push(wLo, "PWL", false)
    wHi := high
    wLo := low
else
    wHi := math.max(nz(wHi, high), high)
    wLo := math.min(nz(wLo, low), low)

// High/low sesi Asia & London
inAsia = not na(time(timeframe.period, asiaSess, TZ))
inLon  = not na(time(timeframe.period, lonSess, TZ))
var float aHi = na
var float aLo = na
var float oHi = na
var float oLo = na
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
else if inAsia
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)
if not inAsia and inAsia[1] and useAsia
    string tg = str.format_time(time, "dd/MM", TZ)
    f_push(aHi, "Asia H " + tg, true)
    f_push(aLo, "Asia L " + tg, false)
if inLon and not inLon[1]
    oHi := high
    oLo := low
else if inLon
    oHi := math.max(oHi, high)
    oLo := math.min(oLo, low)
if not inLon and inLon[1] and useLon
    string tg = str.format_time(time, "dd/MM", TZ)
    f_push(oHi, "London H " + tg, true)
    f_push(oLo, "London L " + tg, false)

// Equal highs/lows dari swing H1 yang masih fresh
var swH = array.new_float()
var swL = array.new_float()
if useEq and h1Done and n >= 3
    float mh = array.get(a_h, n - 2)
    float ml = array.get(a_l, n - 2)
    bool isSwH = mh > array.get(a_h, n - 3) and mh >= array.get(a_h, n - 1)
    bool isSwL = ml < array.get(a_l, n - 3) and ml <= array.get(a_l, n - 1)
    if isSwH and array.size(swH) > 0
        for j = 0 to array.size(swH) - 1
            if math.abs(array.get(swH, j) - mh) <= eqTolPips * pipSize
                f_push(math.max(array.get(swH, j), mh), "EQH " + str.format_time(array.get(a_t, n - 2), "dd/MM HH:mm", TZ), true)
                break
    if isSwH
        array.push(swH, mh)
    if isSwL and array.size(swL) > 0
        for j = 0 to array.size(swL) - 1
            if math.abs(array.get(swL, j) - ml) <= eqTolPips * pipSize
                f_push(math.min(array.get(swL, j), ml), "EQL " + str.format_time(array.get(a_t, n - 2), "dd/MM HH:mm", TZ), false)
                break
    if isSwL
        array.push(swL, ml)
    if array.size(swH) > 30
        array.shift(swH)
    if array.size(swL) > 30
        array.shift(swL)
// swing yang sudah ditembus tidak dipakai lagi untuk equal
if array.size(swH) > 0
    for j = array.size(swH) - 1 to 0
        if high > array.get(swH, j)
            array.remove(swH, j)
if array.size(swL) > 0
    for j = array.size(swL) - 1 to 0
        if low < array.get(swL, j)
            array.remove(swL, j)

// Cek level yang tersapu di candle ini, dan buang level yang sudah terlalu lama
if array.size(lp) > 0
    for j = array.size(lp) - 1 to 0
        bool tooOld = time - array.get(lt, j) > daysBack * 24 * HOUR
        bool fr = array.get(lfr, j)
        if fr and array.get(lt, j) < time
            bool hit = array.get(lhigh, j) ? high > array.get(lp, j) : low < array.get(lp, j)
            if hit
                array.set(lfr, j, false)
                array.set(lst, j, time)
                h1Swept := h1Swept + (h1Swept == "" ? "" : ", ") + array.get(lname, j)
                line.delete(array.get(lln, j))
        if tooOld and (not array.get(lfr, j) ? time - array.get(lst, j) > 24 * HOUR : true)
            line.delete(array.get(lln, j))
            array.remove(lp, j)
            array.remove(lname, j)
            array.remove(lhigh, j)
            array.remove(lt, j)
            array.remove(lfr, j)
            array.remove(lst, j)
            array.remove(lln, j)

if h1Done
    lastSwept := h1Swept
    lastH1T   := cT
    h1Swept   := ""

// Level di satu sisi yang tersapu sejak waktu t0 -> [jumlah, daftar nama]
f_sweptSince(bool isHigh, int t0) =>
    int    cnt   = 0
    string names = ""
    if array.size(lp) > 0
        for j = 0 to array.size(lp) - 1
            if not array.get(lfr, j) and array.get(lhigh, j) == isHigh and array.get(lst, j) >= t0
                cnt += 1
                names := names + (names == "" ? "" : ", ") + array.get(lname, j)
    [cnt, names]

// ---------- Status sesi & trade ----------
var float  refHi    = na
var float  refLo    = na
var int    sStart   = 0      // jam buka candle H4 sesi (ms)
var int    sEnd     = 0      // jam tutup candle H4 sesi (ms)
var int    sHour    = 0
var string bias     = ""
var bool   sessDone = true
var float  sOpen    = na

var bool   inTrade = false
var bool   aOpen   = false
var bool   bOpen   = false
var int    eBar    = 0
var int    tCloseA = 0
var int    tCloseB = 0
var int    tYear   = 0
var string tSide   = ""
var float  tE      = na
var float  tSL     = na
var float  tTP     = na
var float  tSLB    = na
var float  tR      = na
var float  tSpr    = 0.0
var float  rA      = na
var float  rB      = na
var int    aRes    = 0      // 1 TP1, -1 SL, 0 tutup jam

// statistik (dalam R; 1R = risiko total per setup)
var int   nTr   = 0
var int   nTP   = 0
var int   nSL   = 0
var int   nTO   = 0
var int   nFvg  = 0
var int   nRR   = 0
var int   nM30  = 0
var int   nSmall = 0
var float totR  = 0.0
var float eqR   = 0.0
var float pkR   = 0.0
var float ddR   = 0.0
var int   curLs = 0
var int   maxLs = 0
var yrs = array.new_int()
var yrR = array.new_float()
var yrN = array.new_int()
// statistik per sesi H4 (indeks 0..5 = sesi 01, 05, 09, 13, 17, 21)
var sesN  = array.new_int(6, 0)
var sesR  = array.new_float(6, 0.0)
var sesTP = array.new_int(6, 0)
var sesSL = array.new_int(6, 0)
var int tSess = 0
var int tLoc  = 0
// statistik per jumlah level fresh tersapu (indeks 0 = 0 level, 1 = 1 level, 2 = 2+ level)
var locN_ = array.new_int(3, 0)
var locR_ = array.new_float(3, 0.0)

// ---------- Fungsi ----------
f_target(bool isSell, int trig, float entry, bool allowEq) =>
    int   idx = -1
    float px  = na
    int   lo  = math.max(1, trig - lookback)
    if trig - 1 >= lo
        for i = trig - 1 to lo
            float v  = isSell ? array.get(a_l, i)     : array.get(a_h, i)
            float vl = isSell ? array.get(a_l, i - 1) : array.get(a_h, i - 1)
            float vr = isSell ? array.get(a_l, i + 1) : array.get(a_h, i + 1)
            bool okL = isSell ? (allowEq ? v <= vl : v < vl) : (allowEq ? v >= vl : v > vl)
            bool okR = isSell ? v < vr : v > vr
            bool beyond = isSell ? v < entry : v > entry
            if okL and okR and beyond
                idx := i
                px  := v
                break
    [idx, px]

f_fvg(bool isSell, int fromI, int toI) =>
    bool found = false
    if toI - fromI >= 2
        for k = fromI to toI - 2
            bool g = isSell ? array.get(a_h, k) < array.get(a_l, k + 2) : array.get(a_l, k) > array.get(a_h, k + 2)
            if g
                found := true
                break
    found

f_skip(string txt) =>
    if showSkip
        label.new(bar_index, high, txt, style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny)

// ---------- Kelola trade yang sedang berjalan ----------
if inTrade and bar_index >= eBar
    bool isS    = tSide == "SELL"
    bool aTpNow = false
    if aOpen
        if isS ? high + tSpr >= tSL : low <= tSL
            rA    := -1.0
            aRes  := -1
            aOpen := false
        else if isS ? low + tSpr <= tTP : high >= tTP
            rA     := tpRR
            aRes   := 1
            aOpen  := false
            aTpNow := true
    if bOpen and (isS ? high + tSpr >= tSLB : low <= tSLB)
        rB    := (isS ? tE - tSLB : tSLB - tE) / tR
        bOpen := false
    if aTpNow and bOpen
        tSLB := tE
        strategy.exit("XB", "B", stop=tE)
    float rNow = (isS ? tE - (close + tSpr) : close - tE) / tR
    if aOpen and barEnd >= tCloseA
        rA    := rNow
        aRes  := 0
        aOpen := false
        strategy.close("A", comment="tutup jam")
    if bOpen and barEnd >= tCloseB
        rB    := rNow
        bOpen := false
        strategy.close("B", comment="tutup jam")
    if not aOpen and not bOpen
        inTrade := false
        float tot = (rA + rB) / 2
        nTr  += 1
        nTP  += aRes == 1 ? 1 : 0
        nSL  += aRes == -1 ? 1 : 0
        nTO  += aRes == 0 ? 1 : 0
        totR += tot
        eqR  += tot
        pkR  := math.max(pkR, eqR)
        ddR  := math.max(ddR, pkR - eqR)
        curLs := tot < 0 ? curLs + 1 : 0
        maxLs := math.max(maxLs, curLs)
        int li = math.min(tLoc, 2)
        array.set(locN_, li, array.get(locN_, li) + 1)
        array.set(locR_, li, array.get(locR_, li) + tot)
        int si = math.floor(((tSess + 23) % 24) / 4)   // 1->0, 5->1, 9->2, 13->3, 17->4, 21->5
        array.set(sesN, si, array.get(sesN, si) + 1)
        array.set(sesR, si, array.get(sesR, si) + tot)
        array.set(sesTP, si, array.get(sesTP, si) + (aRes == 1 ? 1 : 0))
        array.set(sesSL, si, array.get(sesSL, si) + (aRes == -1 ? 1 : 0))
        int yi = array.indexof(yrs, tYear)
        if yi == -1
            array.push(yrs, tYear)
            array.push(yrR, tot)
            array.push(yrN, 1)
        else
            array.set(yrR, yi, array.get(yrR, yi) + tot)
            array.set(yrN, yi, array.get(yrN, yi) + 1)

// ---------- Candle referensi H4 selesai -> buka sesi berikutnya ----------
// Candle H4 NY berakhir setelah candle H1 jam 00, 04, 08, 12, 16, 20.
if h1Done and n >= 4 and cHr % 4 == 0 and (not allH4 ? cHr == 8 : true)
    // 4 candle H1 terakhir harus berurutan (tanpa celah data)
    if array.get(a_t, n - 1) - array.get(a_t, n - 4) == 3 * HOUR
        refHi    := math.max(math.max(array.get(a_h, n - 4), array.get(a_h, n - 3)), math.max(array.get(a_h, n - 2), array.get(a_h, n - 1)))
        refLo    := math.min(math.min(array.get(a_l, n - 4), array.get(a_l, n - 3)), math.min(array.get(a_l, n - 2), array.get(a_l, n - 1)))
        sStart   := array.get(a_t, n - 1) + HOUR
        sEnd     := sStart + 4 * HOUR
        sHour    := (cHr + 1) % 24
        bias     := ""
        sessDone := false

if time == sStart
    sOpen := open    // open candle H4 sesi

// ---------- Cari setup di candle H1 di dalam candle H4 sesi ----------
// Hasil pencarian ditaruh di variabel kandidat, lalu dibuka di satu tempat.
bool   cOpen  = false
string cSide  = ""
float  cEntry = na
float  cSL    = na
int    cTrigT = 0

// Konfirmasi tertunda: M30 terakhir melawan arah -> tunggu maks 2 candle M30
// yang close searah bias, selama harga belum menembus ujung sweep H1.
var bool   pend    = false
var int    pendCnt = 0
var string pSide   = ""
var float  pSweep  = na
var int    pTrigT  = 0
var int    pEnd    = 0      // jam tutup sesi saat konfirmasi ditunggu
if pend and not inTrade
    pendCnt += 1
    bool pS     = pSide == "SELL"
    bool broke  = pS ? high > pSweep : low < pSweep
    bool conf   = pS ? (close < open and close < refHi) : (close > open and close > refLo)
    if broke or barEnd >= pEnd
        pend := false
        nM30 += 1
        f_skip("M30 melawan (batal)")
    else if conf
        pend   := false
        cOpen  := true
        cSide  := pSide
        cEntry := close
        cSL    := pS ? high : low
        cTrigT := pTrigT
    else if pendCnt >= 2
        pend := false
        nM30 += 1
        f_skip("M30 tidak konfirmasi")

// (Pine v5 tidak berhenti di 'and' pertama, jadi array dibaca terpisah dulu)
int lastT = 0
if n > 0
    lastT := array.get(a_t, n - 1)
if not cOpen and not pend and h1Done and n > 0 and not sessDone and not inTrade and lastT >= sStart and lastT < sEnd
    int   trig = n - 1
    float bo = array.get(a_o, trig)
    float bh = array.get(a_h, trig)
    float bl = array.get(a_l, trig)
    float bc = array.get(a_c, trig)
    bool hiSw = bh > refHi
    bool loSw = bl < refLo
    if bias == ""
        if hiSw and loSw
            sessDone := true
            f_skip("Dua sisi tersapu")
        else if hiSw
            bias := "SELL"
        else if loSw
            bias := "BUY"
    bool isSell = bias == "SELL"
    bool swept  = isSell ? hiSw : loSw
    if not sessDone and bias != "" and swept
        bool validClose = isSell ? (bc < bo and bc < refHi) : (bc > bo and bc > refLo)
        int hk = math.round((array.get(a_t, trig) - sStart) / HOUR) + 1
        if validClose and hk > maxTrigH1
            f_skip("H1 ke-" + str.tostring(hk) + " > " + str.tostring(maxTrigH1))
        else if validClose
            if array.get(a_t, trig) + HOUR >= sEnd
                f_skip("Terlambat")
            else
                bool m30Counter = m30Filter and (isSell ? (low < low[1] and close > open) : (high > high[1] and close < open))
                if m30Counter
                    pend    := true
                    pendCnt := 0
                    pSide   := bias
                    pSweep  := isSell ? bh : bl
                    pTrigT  := array.get(a_t, trig)
                    pEnd    := sEnd
                    f_skip("M30 melawan, tunggu konfirmasi")
                else
                    cOpen  := true
                    cSide  := bias
                    cEntry := bc
                    cSL    := isSell ? high : low     // candle M30 terakhir = candle ini
                    cTrigT := array.get(a_t, trig)

// ---------- Cek filter kandidat lalu buka posisi ----------
if cOpen
    bool  isSell = cSide == "SELL"
    int   trig   = array.indexof(a_t, cTrigT)
    float spr    = sprPips * pipSize
    float entry  = isSell ? cEntry : cEntry + spr          // BUY masuk di harga ask
    float buf    = slBufPips * pipSize
    float sl     = isSell ? cSL + buf : cSL - buf
    float risk   = math.abs(sl - entry)
    int   tgtI   = -1
    float tgtP   = na
    if trig > 0
        [ti1, px1] = f_target(isSell, trig, entry, false)
        [ti2, px2] = f_target(isSell, trig, entry, true)
        tgtI := ti1 != -1 ? ti1 : ti2
        tgtP := ti1 != -1 ? px1 : px2
    [locN, locNames] = f_sweptSince(isSell, sStart)   // level fresh di sisi sweep yang tersapu di sesi ini
    if trig <= 0 or risk <= 0 or (not isSell and sl >= entry) or (isSell and sl <= entry)
        f_skip("SL tidak valid")
    else if liqOn and minLoc > 0 and locN < minLoc
        f_skip("Lokasi lemah (" + str.tostring(locN) + " level)")
    else if openFilt and (isSell ? cEntry <= sOpen : cEntry >= sOpen)
        f_skip("Di luar open H4")
    else if risk / pipSize < minSlPips
        nSmall += 1
        f_skip("SL " + str.tostring(risk / pipSize, "#.#") + " pips < " + str.tostring(minSlPips))
    else if tgtI == -1
        f_skip("Tidak ada swing")
    else if f_fvg(isSell, math.max(0, tgtI - 1), trig)
        nFvg += 1
        f_skip("FVG berlawanan")
    else if math.abs(tgtP - entry) / risk < minRR
        nRR += 1
        f_skip("RR < " + str.tostring(minRR))
    else
        inTrade  := true
        aOpen    := true
        bOpen    := true
        eBar     := bar_index + 1
        tCloseA  := sEnd
        tCloseB  := sEnd + runnerX * HOUR
        tYear    := year(time, TZ)
        tSess    := sHour
        tLoc     := locN
        tSide    := cSide
        tE       := entry
        tSL      := sl
        tSLB     := sl
        tR       := risk
        tSpr     := spr
        tTP      := isSell ? entry - risk * tpRR : entry + risk * tpRR
        rA       := na
        rB       := na
        sessDone := true
        float qty = (strategy.initial_capital * riskPct / 200) / risk
        dir = isSell ? strategy.short : strategy.long
        strategy.entry("A", dir, qty=qty)
        strategy.entry("B", dir, qty=qty)
        strategy.exit("XA", "A", stop=sl, limit=tTP)
        strategy.exit("XB", "B", stop=sl)
        string txt = (isSell ? "SELL" : "BUY") + " (sesi " + str.tostring(sHour, "00") + ":00)" + "\nEntry " + str.tostring(entry, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + " (" + str.tostring(risk / pipSize, "#.#") + " pips)" + "\nTP A " + str.tostring(tTP, format.mintick) + " (" + str.tostring(tpRR, "#.##") + "R)" + "\nSwing " + str.tostring(tgtP, format.mintick) + " (" + str.tostring(math.abs(tgtP - entry) / risk, "#.##") + "R)" + (liqOn ? "\nLokasi: " + str.tostring(locN) + " level" + (locN > 0 ? " (" + locNames + ")" : "") : "")
        label.new(bar_index, isSell ? high : low, txt, style=isSell ? label.style_label_down : label.style_label_up, color=isSell ? color.red : color.green, textcolor=color.white, size=size.small)

// ---------- Gambar ----------
inSess = time >= sStart and time < sEnd
plot(showRef and inSess ? refHi : na, "High referensi", color=color.blue, style=plot.style_linebr)
plot(showRef and inSess ? refLo : na, "Low referensi", color=color.blue, style=plot.style_linebr)
plot(inTrade ? tSLB : na, "SL", color=color.red, style=plot.style_linebr)
plot(inTrade and aOpen ? tTP : na, "TP1", color=color.green, style=plot.style_linebr)

// ---------- Tabel hasil (dalam R) ----------
var table tb = table.new(position.top_right, 3, 30, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    table.clear(tb, 0, 0, 2, 29)
    table.cell(tb, 0, 0, allH4 ? "CRT semua H4" : "CRT NY 09:00", text_color=color.white)
    table.cell(tb, 0, 1, "Setup valid", text_color=color.white)
    table.cell(tb, 1, 1, str.tostring(nTr), text_color=color.white)
    table.cell(tb, 0, 2, "Kena TP A (" + str.tostring(tpRR, "#.##") + "R)", text_color=color.white)
    table.cell(tb, 1, 2, str.tostring(nTP), text_color=color.lime)
    table.cell(tb, 2, 2, nTr > 0 ? str.tostring(100.0 * nTP / nTr, "#") + "%" : "-", text_color=color.lime)
    table.cell(tb, 0, 3, "Kena SL", text_color=color.white)
    table.cell(tb, 1, 3, str.tostring(nSL), text_color=color.red)
    table.cell(tb, 2, 3, nTr > 0 ? str.tostring(100.0 * nSL / nTr, "#") + "%" : "-", text_color=color.red)
    table.cell(tb, 0, 4, "Tutup jam sesi", text_color=color.white)
    table.cell(tb, 1, 4, str.tostring(nTO), text_color=color.white)
    table.cell(tb, 0, 5, "Total R", text_color=color.white)
    table.cell(tb, 1, 5, str.tostring(totR, "#.##"), text_color=totR >= 0 ? color.lime : color.red)
    table.cell(tb, 0, 6, "R per setup", text_color=color.white)
    table.cell(tb, 1, 6, nTr > 0 ? str.tostring(totR / nTr, "#.###") : "-", text_color=color.white)
    table.cell(tb, 0, 7, "Drawdown maks (R)", text_color=color.white)
    table.cell(tb, 1, 7, str.tostring(ddR, "#.##"), text_color=color.orange)
    table.cell(tb, 0, 8, "Kalah beruntun maks", text_color=color.white)
    table.cell(tb, 1, 8, str.tostring(maxLs), text_color=color.orange)
    table.cell(tb, 0, 9, "Batal: FVG / RR / M30 / SL kecil", text_color=color.white)
    table.cell(tb, 1, 9, str.tostring(nFvg) + " / " + str.tostring(nRR) + " / " + str.tostring(nM30) + " / " + str.tostring(nSmall), text_color=color.gray)
    table.cell(tb, 0, 10, "Tahun", text_color=color.yellow)
    table.cell(tb, 1, 10, "R", text_color=color.yellow)
    table.cell(tb, 2, 10, "Setup", text_color=color.yellow)
    int ny = array.size(yrs)
    int st = math.max(0, ny - 18)
    if ny > 0
        for j = st to ny - 1
            int row = 11 + j - st
            float yr = array.get(yrR, j)
            table.cell(tb, 0, row, str.tostring(array.get(yrs, j)), text_color=color.white)
            table.cell(tb, 1, row, str.tostring(yr, "#.##"), text_color=yr >= 0 ? color.lime : color.red)
            table.cell(tb, 2, row, str.tostring(array.get(yrN, j)), text_color=color.white)

// ---------- Tabel hasil per sesi H4 (dalam R) ----------
var table ts = table.new(position.bottom_right, 6, 8, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    table.clear(ts, 0, 0, 5, 7)
    table.cell(ts, 0, 0, "Sesi", text_color=color.yellow)
    table.cell(ts, 1, 0, "Setup", text_color=color.yellow)
    table.cell(ts, 2, 0, "Total R", text_color=color.yellow)
    table.cell(ts, 3, 0, "R/setup", text_color=color.yellow)
    table.cell(ts, 4, 0, "TP A", text_color=color.yellow)
    table.cell(ts, 5, 0, "SL", text_color=color.yellow)
    for k = 0 to 5
        int   nn = array.get(sesN, k)
        float rr = array.get(sesR, k)
        string jam = str.tostring(k * 4 + 1, "00") + ":00"
        table.cell(ts, 0, k + 1, jam, text_color=color.white)
        table.cell(ts, 1, k + 1, str.tostring(nn), text_color=color.white)
        table.cell(ts, 2, k + 1, nn > 0 ? str.tostring(rr, "#.##") : "-", text_color=rr >= 0 ? color.lime : color.red)
        table.cell(ts, 3, k + 1, nn > 0 ? str.tostring(rr / nn, "#.###") : "-", text_color=rr >= 0 ? color.lime : color.red)
        table.cell(ts, 4, k + 1, nn > 0 ? str.tostring(100.0 * array.get(sesTP, k) / nn, "#") + "%" : "-", text_color=color.white)
        table.cell(ts, 5, k + 1, nn > 0 ? str.tostring(100.0 * array.get(sesSL, k) / nn, "#") + "%" : "-", text_color=color.white)

// ---------- Tabel hasil per jumlah level fresh tersapu (lokasi) ----------
var table tloc = table.new(position.bottom_center, 4, 4, bgcolor=color.new(color.black, 15), border_width=1)
if liqOn and barstate.islast
    table.clear(tloc, 0, 0, 3, 3)
    table.cell(tloc, 0, 0, "Lokasi", text_color=color.yellow)
    table.cell(tloc, 1, 0, "Setup", text_color=color.yellow)
    table.cell(tloc, 2, 0, "Total R", text_color=color.yellow)
    table.cell(tloc, 3, 0, "R/setup", text_color=color.yellow)
    for k = 0 to 2
        int   nn = array.get(locN_, k)
        float rr = array.get(locR_, k)
        table.cell(tloc, 0, k + 1, k == 0 ? "0 level" : k == 1 ? "1 level" : "2+ level", text_color=color.white)
        table.cell(tloc, 1, k + 1, str.tostring(nn), text_color=color.white)
        table.cell(tloc, 2, k + 1, nn > 0 ? str.tostring(rr, "#.##") : "-", text_color=rr >= 0 ? color.lime : color.red)
        table.cell(tloc, 3, k + 1, nn > 0 ? str.tostring(rr / nn, "#.###") : "-", text_color=rr >= 0 ? color.lime : color.red)
