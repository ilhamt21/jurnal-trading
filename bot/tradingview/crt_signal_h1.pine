//@version=5
// Sinyal CRT sampai level H1 + notifikasi Telegram (jurnal-trading)
// Pasang di chart M30 atau H1. Semua jam = waktu New York (DST otomatis).
//
// Sinyal SELL (BUY kebalikannya):
// 1. Referensi : high/low candle H4 sebelumnya (default: H4 05:00 untuk sesi 09:00).
// 2. Sweep     : candle H1 di dalam candle H4 sesi menembus HIGH referensi lalu
//                close BEARISH kembali di bawah high. Sisi yang tersapu pertama
//                menentukan bias.
// 3. Target    : swing low H1 terdekat (swing bersih diutamakan, equal lows cadangan).
// 4. Filter    : tidak ada FVG bullish di H1 dari swing target sampai candle sweep.
// Entry, SL (M30), dan manajemen posisi dieksekusi sendiri oleh trader.
//
// Telegram: isi "Telegram Chat ID", lalu buat alert dengan kondisi
// "Any alert() function call" dan Webhook URL:
//   https://api.telegram.org/bot<TOKEN_BOT_ANDA>/sendMessage
indicator("CRT Sinyal H1 + Telegram (jurnal-trading)", shorttitle="CRT H1 Sinyal", overlay=true, max_labels_count=500, max_lines_count=500)

// ---------- Pengaturan ----------
modeSel  = input.string("09:00 saja (SOP)", "Sesi", options=["09:00 saja (SOP)", "Semua H4 (tiap 4 jam)"])
pipIn    = input.float(0, "Ukuran pip (0 = otomatis)", minval=0, tooltip="0 = otomatis: pair JPY 0.01, lainnya 0.0001")
useFvg   = input.bool(true, "Filter FVG berlawanan")
openFilt = input.bool(false, "VARIASI: SELL hanya di atas open H4 sesi, BUY di bawahnya")
maxTrigH1 = input.int(4, "VARIASI: pemicu hanya dari H1 ke-1..N di sesi (4 = semua)", minval=1, maxval=4)
lookback = input.int(48, "Cari swing H1 ke belakang (candle)", minval=5)
showRef  = input.bool(true, "Gambar high/low referensi")
showSkip = input.bool(false, "Tampilkan label sinyal yang batal (FVG / tidak ada swing)")
chatId   = input.string("", "Telegram Chat ID", tooltip="Kosongkan kalau hanya ingin notifikasi TradingView biasa")

// ---------- Pengaturan monitor likuiditas ----------
grpL      = "Monitor likuiditas (level fresh)"
liqOn     = input.bool(true, "Aktifkan monitor likuiditas", group=grpL)
daysBack  = input.int(3, "Simpan level berapa hari ke belakang", minval=1, maxval=20, group=grpL)
useDay    = input.bool(true, "High/low harian (PDH/PDL)", group=grpL)
useWeek   = input.bool(true, "High/low minggu lalu (PWH/PWL)", group=grpL)
useAsia   = input.bool(true, "High/low sesi Asia", group=grpL)
asiaSess  = input.session("2000-2359", "Jam sesi Asia (NY)", group=grpL)
useLon    = input.bool(true, "High/low sesi London", group=grpL)
lonSess   = input.session("0200-0500", "Jam sesi London (NY)", group=grpL)
useEq     = input.bool(true, "Equal highs/lows (swing H1)", group=grpL)
eqTolPips = input.float(1.0, "Toleransi equal (pips)", minval=0, step=0.1, group=grpL)
showLvl   = input.bool(true, "Gambar garis level fresh", group=grpL)
minLoc    = input.int(0, "Filter: minimal level fresh tersapu di sisi sweep (0 = mati)", minval=0, group=grpL)

TZ    = "America/New_York"
HOUR  = 3600000
allH4 = modeSel == "Semua H4 (tiap 4 jam)"
pip   = pipIn > 0 ? pipIn : (syminfo.currency == "JPY" ? 0.01 : 0.0001)

isH1 = timeframe.period == "60"
if timeframe.period != "30" and not isH1
    runtime.error("Pakai chart M30 atau H1.")

nyH = hour(time, TZ)
nyM = minute(time, TZ)

// ---------- Candle H1 (langsung di chart H1, atau disusun dari M30) ----------
var a_o  = array.new_float()
var a_h  = array.new_float()
var a_l  = array.new_float()
var a_c  = array.new_float()
var a_hr = array.new_int()
var a_t  = array.new_int()

var float cO  = na
var float cH  = na
var float cL  = na
var float cC  = na
var int   cHr = -1
var int   cT  = 0

h1Done = false
if isH1
    cO  := open
    cH  := high
    cL  := low
    cC  := close
    cHr := nyH
    cT  := time
    h1Done := true
else if nyM == 0
    cO  := open
    cH  := high
    cL  := low
    cC  := close
    cHr := nyH
    cT  := time
else if nyM == 30
    if cHr == nyH and time - cT == 30 * 60000
        cH := math.max(cH, high)
        cL := math.min(cL, low)
        cC := close
    else
        cO  := open
        cH  := high
        cL  := low
        cC  := close
        cHr := nyH
        cT  := time - 30 * 60000
    h1Done := true

if h1Done
    array.push(a_o, cO)
    array.push(a_h, cH)
    array.push(a_l, cL)
    array.push(a_c, cC)
    array.push(a_hr, cHr)
    array.push(a_t, cT)
    if array.size(a_o) > 400
        array.shift(a_o)
        array.shift(a_h)
        array.shift(a_l)
        array.shift(a_c)
        array.shift(a_hr)
        array.shift(a_t)

n = array.size(a_o)

// ---------- Monitor likuiditas: level fresh & yang sudah tersapu ----------
var lp    = array.new_float()    // harga level
var lname = array.new_string()   // nama level
var lhigh = array.new_bool()     // true = level atas (high)
var lt    = array.new_int()      // waktu level dibuat
var lfr   = array.new_bool()     // masih fresh?
var lst   = array.new_int()      // waktu tersapu
var lln   = array.new_line()     // garis di chart
var string h1Swept   = ""        // level tersapu di candle H1 yang sedang berjalan
var string lastSwept = ""        // level tersapu di candle H1 terakhir yang sudah close
var int    lastH1T   = 0

f_push(float price, string name, bool isHigh) =>
    if liqOn and not na(price)
        array.push(lp, price)
        array.push(lname, name)
        array.push(lhigh, isHigh)
        array.push(lt, time)
        array.push(lfr, true)
        array.push(lst, 0)
        line ln = na
        if showLvl
            ln := line.new(bar_index, price, bar_index + 1, price, extend=extend.right, color=isHigh ? color.new(color.red, 40) : color.new(color.green, 40), style=line.style_dotted)
        array.push(lln, ln)

// High/low harian (hari forex mulai 17:00 NY) dan mingguan
var float dHi = na
var float dLo = na
var int   dT  = 0
var float wHi = na
var float wLo = na
if timeframe.change("D")
    if useDay and not na(dHi)
        string tg = str.format_time(dT, "dd/MM", TZ)
        f_push(dHi, "PDH " + tg, true)
        f_push(dLo, "PDL " + tg, false)
    dHi := high
    dLo := low
    dT  := time
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
if timeframe.change("W")
    if useWeek and not na(wHi)
        f_push(wHi, "PWH", true)
        f_push(wLo, "PWL", false)
    wHi := high
    wLo := low
else
    wHi := math.max(nz(wHi, high), high)
    wLo := math.min(nz(wLo, low), low)

// High/low sesi Asia & London
inAsia = not na(time(timeframe.period, asiaSess, TZ))
inLon  = not na(time(timeframe.period, lonSess, TZ))
var float aHi = na
var float aLo = na
var float oHi = na
var float oLo = na
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
else if inAsia
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)
if not inAsia and inAsia[1] and useAsia
    string tg = str.format_time(time, "dd/MM", TZ)
    f_push(aHi, "Asia H " + tg, true)
    f_push(aLo, "Asia L " + tg, false)
if inLon and not inLon[1]
    oHi := high
    oLo := low
else if inLon
    oHi := math.max(oHi, high)
    oLo := math.min(oLo, low)
if not inLon and inLon[1] and useLon
    string tg = str.format_time(time, "dd/MM", TZ)
    f_push(oHi, "London H " + tg, true)
    f_push(oLo, "London L " + tg, false)

// Equal highs/lows dari swing H1 yang masih fresh
var swH = array.new_float()
var swL = array.new_float()
if useEq and h1Done and n >= 3
    float mh = array.get(a_h, n - 2)
    float ml = array.get(a_l, n - 2)
    bool isSwH = mh > array.get(a_h, n - 3) and mh >= array.get(a_h, n - 1)
    bool isSwL = ml < array.get(a_l, n - 3) and ml <= array.get(a_l, n - 1)
    if isSwH and array.size(swH) > 0
        for j = 0 to array.size(swH) - 1
            if math.abs(array.get(swH, j) - mh) <= eqTolPips * pip
                f_push(math.max(array.get(swH, j), mh), "EQH " + str.format_time(array.get(a_t, n - 2), "dd/MM HH:mm", TZ), true)
                break
    if isSwH
        array.push(swH, mh)
    if isSwL and array.size(swL) > 0
        for j = 0 to array.size(swL) - 1
            if math.abs(array.get(swL, j) - ml) <= eqTolPips * pip
                f_push(math.min(array.get(swL, j), ml), "EQL " + str.format_time(array.get(a_t, n - 2), "dd/MM HH:mm", TZ), false)
                break
    if isSwL
        array.push(swL, ml)
    if array.size(swH) > 30
        array.shift(swH)
    if array.size(swL) > 30
        array.shift(swL)
// swing yang sudah ditembus tidak dipakai lagi untuk equal
if array.size(swH) > 0
    for j = array.size(swH) - 1 to 0
        if high > array.get(swH, j)
            array.remove(swH, j)
if array.size(swL) > 0
    for j = array.size(swL) - 1 to 0
        if low < array.get(swL, j)
            array.remove(swL, j)

// Cek level yang tersapu di candle ini, dan buang level yang sudah terlalu lama
if array.size(lp) > 0
    for j = array.size(lp) - 1 to 0
        bool tooOld = time - array.get(lt, j) > daysBack * 24 * HOUR
        bool fr = array.get(lfr, j)
        if fr and array.get(lt, j) < time
            bool hit = array.get(lhigh, j) ? high > array.get(lp, j) : low < array.get(lp, j)
            if hit
                array.set(lfr, j, false)
                array.set(lst, j, time)
                h1Swept := h1Swept + (h1Swept == "" ? "" : ", ") + array.get(lname, j)
                line.delete(array.get(lln, j))
        if tooOld and (not array.get(lfr, j) ? time - array.get(lst, j) > 24 * HOUR : true)
            line.delete(array.get(lln, j))
            array.remove(lp, j)
            array.remove(lname, j)
            array.remove(lhigh, j)
            array.remove(lt, j)
            array.remove(lfr, j)
            array.remove(lst, j)
            array.remove(lln, j)

if h1Done
    lastSwept := h1Swept
    lastH1T   := cT
    h1Swept   := ""

// Level di satu sisi yang tersapu sejak waktu t0 -> [jumlah, daftar nama]
f_sweptSince(bool isHigh, int t0) =>
    int    cnt   = 0
    string names = ""
    if array.size(lp) > 0
        for j = 0 to array.size(lp) - 1
            if not array.get(lfr, j) and array.get(lhigh, j) == isHigh and array.get(lst, j) >= t0
                cnt += 1
                names := names + (names == "" ? "" : ", ") + array.get(lname, j)
    [cnt, names]

// ---------- Status sesi ----------
var float  refHi    = na
var float  refLo    = na
var int    sStart   = 0
var int    sEnd     = 0
var int    sHour    = 0
var string bias     = ""
var bool   sessDone = true
var float  sOpen    = na

// ---------- Fungsi ----------
f_target(bool isSell, int trig, float entry, bool allowEq) =>
    int   idx = -1
    float px  = na
    int   lo  = math.max(1, trig - lookback)
    if trig - 1 >= lo
        for i = trig - 1 to lo
            float v  = isSell ? array.get(a_l, i)     : array.get(a_h, i)
            float vl = isSell ? array.get(a_l, i - 1) : array.get(a_h, i - 1)
            float vr = isSell ? array.get(a_l, i + 1) : array.get(a_h, i + 1)
            bool okL = isSell ? (allowEq ? v <= vl : v < vl) : (allowEq ? v >= vl : v > vl)
            bool okR = isSell ? v < vr : v > vr
            bool beyond = isSell ? v < entry : v > entry
            if okL and okR and beyond
                idx := i
                px  := v
                break
    [idx, px]

f_fvg(bool isSell, int fromI, int toI) =>
    bool found = false
    if toI - fromI >= 2
        for k = fromI to toI - 2
            bool g = isSell ? array.get(a_h, k) < array.get(a_l, k + 2) : array.get(a_l, k) > array.get(a_h, k + 2)
            if g
                found := true
                break
    found

f_skip(string txt) =>
    if showSkip
        label.new(bar_index, high, txt, style=label.style_label_down, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny)

f_px(float v) =>
    str.tostring(v, format.mintick)

// ---------- Candle referensi H4 selesai -> buka sesi berikutnya ----------
if h1Done and n >= 4 and cHr % 4 == 0 and (not allH4 ? cHr == 8 : true)
    if array.get(a_t, n - 1) - array.get(a_t, n - 4) == 3 * HOUR
        refHi    := math.max(math.max(array.get(a_h, n - 4), array.get(a_h, n - 3)), math.max(array.get(a_h, n - 2), array.get(a_h, n - 1)))
        refLo    := math.min(math.min(array.get(a_l, n - 4), array.get(a_l, n - 3)), math.min(array.get(a_l, n - 2), array.get(a_l, n - 1)))
        sStart   := array.get(a_t, n - 1) + HOUR
        sEnd     := sStart + 4 * HOUR
        sHour    := (cHr + 1) % 24
        bias     := ""
        sessDone := false

if time == sStart
    sOpen := open    // open candle H4 sesi

// ---------- Cari sinyal di candle H1 di dalam candle H4 sesi ----------
bool   sigBuy  = false
bool   sigSell = false
int lastT = 0
if n > 0
    lastT := array.get(a_t, n - 1)
if h1Done and n > 0 and not sessDone and lastT >= sStart and lastT < sEnd
    int   trig = n - 1
    float bo = array.get(a_o, trig)
    float bh = array.get(a_h, trig)
    float bl = array.get(a_l, trig)
    float bc = array.get(a_c, trig)
    bool hiSw = bh > refHi
    bool loSw = bl < refLo
    if bias == ""
        if hiSw and loSw
            sessDone := true
            f_skip("Dua sisi tersapu")
        else if hiSw
            bias := "SELL"
        else if loSw
            bias := "BUY"
    bool isSell = bias == "SELL"
    bool swept  = isSell ? hiSw : loSw
    if not sessDone and bias != "" and swept
        bool validClose = isSell ? (bc < bo and bc < refHi) : (bc > bo and bc > refLo)
        int  hk     = math.round((array.get(a_t, trig) - sStart) / HOUR) + 1
        bool openOk = not openFilt or (isSell ? bc > sOpen : bc < sOpen)
        if validClose and hk > maxTrigH1
            f_skip("H1 ke-" + str.tostring(hk) + " > " + str.tostring(maxTrigH1))
        else if validClose and not openOk
            f_skip("Di luar open H4")
        else if validClose
            [ti1, px1] = f_target(isSell, trig, bc, false)
            [ti2, px2] = f_target(isSell, trig, bc, true)
            int   tgtI = ti1 != -1 ? ti1 : ti2
            float tgtP = ti1 != -1 ? px1 : px2
            [locN, locNames] = f_sweptSince(isSell, sStart)
            if tgtI == -1
                f_skip("Tidak ada swing")
            else if liqOn and minLoc > 0 and locN < minLoc
                f_skip("Lokasi lemah (" + str.tostring(locN) + " level)")
            else if useFvg and f_fvg(isSell, math.max(0, tgtI - 1), trig)
                f_skip("FVG berlawanan")
            else
                sessDone := true
                sigSell  := isSell
                sigBuy   := not isSell
                bool   lastH1 = array.get(a_t, trig) + HOUR >= sEnd
                string h1Jam  = str.format_time(array.get(a_t, trig), "HH:mm", TZ)
                string sesJam = str.tostring(sHour, "00") + ":00"
                float  sweepX = isSell ? bh : bl
                float  refX   = isSell ? refHi : refLo
                float  dist   = math.abs(bc - tgtP) / pip
                string nl     = "\\n"
                string msg = (isSell ? "SELL " : "BUY ") + syminfo.ticker + " - CRT sesi H4 " + sesJam + " NY" + nl + "H1 " + h1Jam + " close " + f_px(bc) + nl + "Sweep " + (isSell ? "high " : "low ") + f_px(refX) + " sampai " + f_px(sweepX) + nl + "Target swing H1: " + f_px(tgtP) + " (" + str.tostring(dist, "#.#") + " pips)" + nl + "FVG berlawanan: tidak ada" + (liqOn ? nl + "Level fresh tersapu sesi ini (" + str.tostring(locN) + "): " + (locN > 0 ? locNames : "-") : "") + (lastH1 ? nl + "Catatan: candle H1 terakhir di sesi ini" : "") + nl + "Lanjut cek M30 untuk entry dan SL."
                // Telegram butuh JSON (baris baru ditulis \n); notifikasi biasa pakai baris baru asli
                string payload = chatId == "" ? str.replace_all(msg, "\\n", "\n") : "{\"chat_id\":\"" + chatId + "\",\"text\":\"" + msg + "\"}"
                alert(payload, alert.freq_once_per_bar_close)
                string lbl = (isSell ? "SELL" : "BUY") + " (sesi " + sesJam + ")" + "\nH1 " + h1Jam + " close " + f_px(bc) + "\nTarget " + f_px(tgtP) + " (" + str.tostring(dist, "#.#") + " pips)"
                label.new(bar_index, isSell ? high : low, lbl, style=isSell ? label.style_label_down : label.style_label_up, color=isSell ? color.red : color.green, textcolor=color.white, size=size.small)

// ---------- Gambar ----------
inSess = time >= sStart and time < sEnd
plot(showRef and inSess ? refHi : na, "High referensi", color=color.blue, style=plot.style_linebr)
plot(showRef and inSess ? refLo : na, "Low referensi", color=color.blue, style=plot.style_linebr)
plotshape(sigSell, "Sinyal SELL", shape.triangledown, location.abovebar, color.red, size=size.tiny)
plotshape(sigBuy, "Sinyal BUY", shape.triangleup, location.belowbar, color.green, size=size.tiny)

// ---------- Tabel monitor likuiditas ----------
var table tl = table.new(position.bottom_left, 3, 9, bgcolor=color.new(color.black, 15), border_width=1)
if liqOn and barstate.islast
    table.clear(tl, 0, 0, 2, 8)
    table.cell(tl, 0, 0, "Close H1 " + str.format_time(lastH1T, "dd/MM HH:mm", TZ), text_color=color.yellow)
    table.cell(tl, 1, 0, "Disapu: " + (lastSwept == "" ? "-" : lastSwept), text_color=color.white, text_halign=text.align_left)
    table.merge_cells(tl, 1, 0, 2, 0)
    // 3 level fresh terdekat di atas dan di bawah harga
    for side = 0 to 1
        bool  up   = side == 0
        float prev = up ? close : close
        for r = 0 to 2
            int   best = -1
            float bd   = 1e10
            if array.size(lp) > 0
                for j = 0 to array.size(lp) - 1
                    float pr = array.get(lp, j)
                    bool  ok = array.get(lfr, j) and array.get(lhigh, j) == up and (up ? pr > prev : pr < prev)
                    if ok and math.abs(pr - close) < bd
                        bd   := math.abs(pr - close)
                        best := j
            int row = up ? 3 - r : 5 + r
            if best >= 0
                prev := array.get(lp, best)
                table.cell(tl, 0, row, up ? "Fresh di atas" : "Fresh di bawah", text_color=up ? color.red : color.lime)
                table.cell(tl, 1, row, array.get(lname, best), text_color=color.white)
                table.cell(tl, 2, row, f_px(array.get(lp, best)) + " (" + str.tostring(bd / pip, "#.#") + " pips)", text_color=color.white)
    table.cell(tl, 0, 4, "Harga " + f_px(close), text_color=color.gray)
